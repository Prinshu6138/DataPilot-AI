# Backend environment. Export these in the launch shell, or pass this file as
# Docker's --env-file with an appropriate container database URL.
DATABASE_URL=sqlite:///./datapilot.db
COOKIE_SECURE=auto
ENABLE_DEMO=true
# Set true only behind a trusted proxy that appends or replaces forwarded IPs.
TRUST_PROXY_IP=false
# Build-time Vite flag, optional: put it in frontend/.env.
# VITE_AUTO_DEMO=false
